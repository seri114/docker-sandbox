# Port Configuration
# カスタマイズ可能なポート設定
# ポートが競合する場合は値を変更してください

# Web UI (nginx)
WEB_UI_PORT=8080

# Sandbox Controller API
SANDBOX_CONTROLLER_PORT=18080

# CORS Configuration
# 許可するオリジンをカンマ区切りで指定
# デフォルト: localhostのみ許可（セキュリティのため）
# 本番環境では具体的なオリジンを指定してください
CORS_ORIGINS=http://localhost:8080,http://localhost:18080,http://127.0.0.1:8080,http://127.0.0.1:18080
